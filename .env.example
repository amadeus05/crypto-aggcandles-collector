# ===================== Server Configuration =====================

# Port for the HTTP server (default: 3000)
PORT=3000

# ===================== Database Configuration =====================

# Supabase project URL (required if USE_COCKROACH is not 'true')
SUPABASE_URL=your_supabase_url_here

# Supabase anon/service key (required if USE_COCKROACH is not 'true')
SUPABASE_KEY=your_supabase_key_here

# CockroachDB connection string (required if USE_COCKROACH is 'true')
COCKROACH_CONNECTION_STRING=your_cockroach_connection_string_here

# Path to CockroachDB certificate file (optional, defaults to ~/.postgresql/root.crt)
COCKROACH_CERT_PATH=

# Use CockroachDB instead of Supabase (default: false)
# Set to 'true' to use CockroachDB, 'false' or leave empty to use Supabase
USE_COCKROACH=false

# Data TTL in days - how long to keep data before cleanup (default: 2)
DATA_TTL_DAYS=1

# ===================== Binance Market Data Provider Configuration =====================

# Symbol selection mode: 'ALL', 'TOP', or use whitelist/blacklist (default: 'ALL')
# - 'ALL': All available perpetual USDT futures
# - 'TOP': Top N symbols by 24h volume (see TOP_SYMBOLS_LIMIT)
SYMBOL_MODE=TOP

# Maximum number of symbols when SYMBOL_MODE is 'TOP' (default: 100)
TOP_SYMBOLS_LIMIT=50

# Comma-separated list of symbols to include (whitelist)
# If set, only these symbols will be used (overrides SYMBOL_MODE)
# Example: SYMBOL_WHITELIST=BTCUSDT,ETHUSDT,SOLUSDT
SYMBOL_WHITELIST=

# Comma-separated list of symbols to exclude (blacklist)
# Example: SYMBOL_BLACKLIST=USDCUSDT,BUSDUSDT
SYMBOL_BLACKLIST=

# Open Interest update mode: 'SMART' or 'FIXED' (default: 'SMART')
# - 'SMART': Updates OI based on priority and activity
# - 'FIXED': Updates OI at fixed intervals (see OI_FIXED_INTERVAL_MS)
OI_UPDATE_MODE=FIXED

# Fixed interval for OI updates in milliseconds (default: 10000)
# Only used when OI_UPDATE_MODE is 'FIXED'
OI_FIXED_INTERVAL_MS=10000

# Enable rate limiter for OI API requests (default: false)
# Set to 'true' to use p-queue rate limiter (35 req/sec)
USE_RATE_LIMITER=true

